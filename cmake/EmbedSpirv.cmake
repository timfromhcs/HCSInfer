# Reads a SPIR-V binary and writes a C++ header with a byte array.
# Invoked from cmake/HcsShaders.cmake as: cmake -DINPUT=.. -DOUTPUT=.. -DSYM=.. -P EmbedSpirv.cmake
if(NOT INPUT OR NOT OUTPUT OR NOT SYM)
  message(FATAL_ERROR "EmbedSpirv.cmake needs -DINPUT=<spv> -DOUTPUT=<hpp> -DSYM=<symbol>")
endif()
file(READ "${INPUT}" _hex HEX)
string(REGEX REPLACE "(..)" "0x\\1, " _bytes "${_hex}")
file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedSpirv.cmake from ${SYM}. Do not edit.
#pragma once
#include <cstddef>
namespace hcs::shaders {
inline constexpr unsigned char k${SYM}[] = {${_bytes}};
inline constexpr std::size_t k${SYM}Size = sizeof(k${SYM});
}  // namespace hcs::shaders
")
