# Generates a C++ translation unit that embeds the UI assets as byte arrays.
# Usage: cmake -DASSET_DIR=<dir> -DOUT=<file.cpp> "-DASSETS=index.html;app.css;app.js" -P embed_assets.cmake
# Content types are derived from the extension; unknown extensions are an error (never serve guessed types).
if(NOT ASSET_DIR OR NOT OUT OR NOT ASSETS)
  message(FATAL_ERROR "embed_assets.cmake: ASSET_DIR, OUT and ASSETS are required")
endif()

set(_body "// GENERATED by src/gui/embed_assets.cmake - do not edit.\n#include \"hcs/gui/gui_assets.hpp\"\n\nnamespace hcs::gui::detail {\nnamespace {\n")
set(_table "")
set(_i 0)
foreach(_name IN LISTS ASSETS)
  get_filename_component(_ext "${_name}" LAST_EXT)
  if(_ext STREQUAL ".html")
    set(_ct "text/html; charset=utf-8")
  elseif(_ext STREQUAL ".css")
    set(_ct "text/css; charset=utf-8")
  elseif(_ext STREQUAL ".js")
    set(_ct "text/javascript; charset=utf-8")
  else()
    message(FATAL_ERROR "embed_assets.cmake: no content type for '${_name}'")
  endif()
  file(READ "${ASSET_DIR}/${_name}" _hex HEX)
  string(LENGTH "${_hex}" _hexlen)
  math(EXPR _size "${_hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" _bytes "${_bytes}")
  string(APPEND _body "const unsigned char kData${_i}[] = {\n${_bytes}\n};\n")
  string(APPEND _table "    {\"${_name}\", \"${_ct}\", kData${_i}, ${_size}},\n")
  math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _body "}  // namespace\n\nconst EmbeddedAsset kEmbeddedAssets[] = {\n${_table}};\nconst std::size_t kEmbeddedAssetCount = ${_i};\n\n}  // namespace hcs::gui::detail\n")

# Write only when changed so an unchanged asset set does not trigger recompilation.
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _body)
  file(WRITE "${OUT}" "${_body}")
endif()
